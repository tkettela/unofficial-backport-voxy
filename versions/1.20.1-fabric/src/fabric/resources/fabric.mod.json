{
  "schemaVersion": 1,
  "id": "voxy",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "Unofficial Backport Voxy",
  "description": "Unofficial 1.20.1 backport of Voxy (far distance rendering with LoDs by Cortex) with LoDs sent by the server, background terrain generation and impact presets. Not supported by Cortex.",
  "authors": [
    "Cortex (Voxy)"
  ],
  "contributors": [
    "m3t4f1v3 (multiversion port)",
    "tkettela (unofficial backport, server LoDs)"
  ],
  "contact": {
    "sources": "https://github.com/tkettela/unofficial-backport-voxy",
    "issues": "https://github.com/tkettela/unofficial-backport-voxy/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/voxy/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.cortex.voxy.client.FabricVoxyClient",
      "me.cortex.voxy.client.network.ClientLodReceiver",
      "me.cortex.voxy.client.network.VoxyToggleKey"
    ],
    "modmenu": [
      "me.cortex.voxy.client.config.ModMenuIntegration"
    ],
    "main": [
      "me.cortex.voxy.commonImpl.FabricVoxyCommon",
      "me.cortex.voxy.commonImpl.network.ServerLodStreamer"
    ]
  },
  "mixins": [
    {
      "config": "client.voxy.mixins.json",
      "environment": "client"
    },
    "common.voxy.mixins.json",
    "serverlod.voxy.mixins.json"
  ],
  "depends": {
    "minecraft": [
      "1.20.1"
    ],
    "fabricloader": ">=0.14.22",
    "fabric-api": ">=0.91.1"
  },
  "recommends": {
    "sodium": "0.5.13"
  },
  "breaks": {
    "sodium": ["<0.5.13", ">0.5.13"],
    "voxyworldgenv2": "=2.2.2"
  },
  "accessWidener": "voxy.accesswidener"
}
